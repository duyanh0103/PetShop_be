# Neon connection string: do NOT commit secrets to public repos
# DATABASE_URL → dùng cho ứng dụng (pooled connection).
# DIRECT_URL → dùng cho migration (direct connection).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Chuỗi bí mật ký JWT: dùng chuỗi ngẫu nhiên dài (vd: `openssl rand -base64 48`)
JWT_SECRET=change-me
PORT=3000

# Danh sách origin FE được phép gọi API (cách nhau bởi dấu phẩy)
CORS_ORIGIN=http://localhost:5173

# Tài khoản SUPER_ADMIN tạo bởi `npm run seed` (bắt buộc đổi mật khẩu khi lên production)
SEED_SUPER_ADMIN_USERNAME=superadmin@petshop.com
SEED_SUPER_ADMIN_PASSWORD=change-me

# Phí ship đồng giá (VND) và ngưỡng đơn hàng được miễn phí ship (VND)
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=500000
