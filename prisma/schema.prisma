generator client {
  provider        = "prisma-client-js"
  // Loads `include`d relations in the same query instead of one query per
  // relation; every round trip to Neon costs ~250ms from here.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations go through Neon's direct (non-pooled) endpoint.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  fullName  String?
  phone     String?
  password  String
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

enum CategoryType {
  CATEGORY
  BRAND
}

model Category {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  description  String?
  imageUrl     String?
  type         CategoryType      @default(CATEGORY)
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  // Legacy: Product.categoryId is the primary category (first of categoryIds).
  products     Product[]
  productLinks ProductCategory[]

  @@index([isActive])
}

// Many-to-many: a product can sit in several categories/brands.
model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Product {
  id          String            @id @default(uuid())
  name        String
  sku         String            @unique
  price       Decimal
  quantity    Int
  imageUrl    String?
  description String?
  isActive    Boolean           @default(true)
  categoryId  String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  category    Category          @relation(fields: [categoryId], references: [id])
  categories  ProductCategory[]
  orderItems  OrderItem[]

  @@index([isActive])
}

model Order {
  id              String        @id @default(uuid())
  code            String        @unique
  userId          String
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  shippingName    String
  shippingPhone   String
  shippingAddress String
  note            String?
  subtotal        Decimal
  shippingFee     Decimal
  total           Decimal
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([userId, createdAt])
  @@index([status])
}

// Name, SKU, image and price are copied at purchase time, so an order keeps
// its history after the product is edited or deleted.
model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  sku         String
  imageUrl    String?
  unitPrice   Decimal
  quantity    Int
  lineTotal   Decimal
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// Per-day counter behind order codes (PS20261104-0001).
model OrderCounter {
  date  String @id
  value Int
}
